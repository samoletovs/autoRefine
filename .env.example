# autoRefine — .env template
# Copy to .env and fill in values. Never commit .env.

# Azure AI Foundry connection (used by plan/refine modes)
AZURE_AI_PROJECT_CONNECTION_STRING=
FOUNDRY_PROJECT_ENDPOINT=

# Model strategy (see AGENTS.md "Model strategy"):
#   - FOUNDRY_DEFAULT_DEPLOYMENT — used by plan/refine modes for the agentic loop.
#     Default 'gpt-4o-mini' (cheap; runs daily across 11 repos).
#     Bump to 'gpt-5' for a deep-analysis run via `python -m agent.main --model gpt-5`.
#   - HEALTH_SCAN_MODEL — used by health-scan mode for the AI analyst step.
#     Default 'gpt-4o-mini' (twice-daily). The closed-loop deep reviewer
#     (claude-deep-review.py in samoletovs/nauroLabs-github) uses GitHub Models
#     with claude-opus-4 + claude-sonnet-4 fallback; that is configured there,
#     not here.
FOUNDRY_DEFAULT_DEPLOYMENT=gpt-4o-mini

# Prompt budget for plan/refine runs (see agent/foundry_agent.py).
#   AUTOREFINE_TRUNCATION_LAST_MESSAGES is the real per-turn cost lever: it
#     bounds how much thread history is re-sent each tool round, turning a run's
#     input cost from O(rounds^2) into roughly O(rounds).
#   AUTOREFINE_MAX_PROMPT_TOKENS is RUN-WIDE and CUMULATIVE across all turns,
#     not a per-call limit. It is a runaway guard only. Measured traffic
#     averages ~11.5k input tokens per call, so a multi-round plan legitimately
#     spends well over 100k; setting this low will end runs as 'incomplete'
#     before submit_plan. Lower it only with evidence that runs still complete.
AUTOREFINE_MAX_PROMPT_TOKENS=200000
AUTOREFINE_TRUNCATION_LAST_MESSAGES=12

# Azure OpenAI (used by health-scan AI analysis)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
HEALTH_SCAN_MODEL=gpt-4o-mini

# Azure subscription (used by health-scan: cost + App Insights queries)
AZURE_SUBSCRIPTION_ID=

# GitHub access (for cloning repos, creating PRs, committing reports)
GITHUB_TOKEN=
GH_TOKEN=

# NauroLabs ops Telegram bot (created via @BotFather — see PLATFORM.md §8)
NAURO_BOT_TOKEN=
NAURO_CHAT_ID=
