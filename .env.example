# autoRefine — .env template
# Copy to .env and fill in values. Never commit .env.

# Azure AI Foundry connection (used by plan/refine modes)
AZURE_AI_PROJECT_CONNECTION_STRING=
FOUNDRY_PROJECT_ENDPOINT=

# Model strategy (see AGENTS.md "Model strategy"):
#   - FOUNDRY_DEFAULT_DEPLOYMENT — used by plan/refine modes for the agentic loop.
#     Keep 'gpt-4o-mini'. Luna/Sol classic runs have not passed their service gate.
#     Explicit --model overrides cannot bypass that gate; gpt-4.1 rollback remains.
#   - HEALTH_SCAN_MODEL — used by health-scan mode for the AI analyst step.
#     Candidate 'gpt-6-luna' with reasoning_effort=none. The closed-loop deep reviewer
#     (claude-deep-review.py in samoletovs/nauroLabs-github) uses GitHub Models
#     with claude-opus-4 + claude-sonnet-4 fallback; that is configured there,
#     not here.
FOUNDRY_DEFAULT_DEPLOYMENT=gpt-4o-mini

# Prompt budget for plan/refine runs (see agent/foundry_agent.py).
#   AUTOREFINE_TRUNCATION_LAST_MESSAGES is the real per-turn cost lever: it
#     bounds how much thread history is re-sent each tool round, turning a run's
#     input cost from O(rounds^2) into roughly O(rounds).
#   AUTOREFINE_MAX_PROMPT_TOKENS is RUN-WIDE and CUMULATIVE across all turns,
#     not a per-call limit. It is a runaway guard only. Measured traffic
#     averages ~11.5k input tokens per call, so a multi-round plan legitimately
#     spends well over 100k; setting this low will end runs as 'incomplete'
#     before submit_plan. Lower it only with evidence that runs still complete.
AUTOREFINE_MAX_PROMPT_TOKENS=200000
AUTOREFINE_MAX_COMPLETION_TOKENS=16000
# Prepared Sol caps are 40000/4000, but all classic Sol calls remain blocked.
# Classic SDK has no reasoning_effort parameter: do not fake it with **kwargs.
AUTOREFINE_TRUNCATION_LAST_MESSAGES=12

# Activity gate for the manifest sweep (see should_plan_repo in agent/main.py).
# The sweep re-planned every project daily. Replayed over 30 days of real history
# across 24 repos, only 33% of project-days have anything new to plan about, so most
# of those Foundry runs re-derived yesterday's ideas. A swept project is planned when
# its default branch has a substantive commit inside the lookback window, or when its
# deterministic rotation slot comes up. Commits touching only lab-wide housekeeping
# paths (LICENSE, .github/**, synced scripts — see HOUSEKEEPING_PATHSPECS) do not
# count: those sweeps hit every repo on the same day and change nothing a plan says.
#   AUTOREFINE_ACTIVITY_LOOKBACK_HOURS — window; 26h = the daily sweep plus margin.
#     Set to 0 to disable the gate and plan every project, as before.
#   AUTOREFINE_ROTATION_DAYS — staleness floor. Every project is planned at least
#     this often however quiet it is, spread evenly across the days so the floor
#     never fires for the whole fleet at once.
# An explicit `--repo` is never gated: that is a human asking for this project now.
AUTOREFINE_ACTIVITY_LOOKBACK_HOURS=26
AUTOREFINE_ROTATION_DAYS=7

# Azure OpenAI (used by health-scan AI analysis)
AZURE_OPENAI_ENDPOINT=
# HEALTH_SCAN_MODEL is authoritative; AZURE_OPENAI_DEPLOYMENT is not read here.
HEALTH_SCAN_MODEL=gpt-6-luna
HEALTH_SCAN_MAX_TOKENS=4000

# Azure subscription (used by health-scan: cost + App Insights queries)
AZURE_SUBSCRIPTION_ID=
# Reporting only: the VS Enterprise benefit, not a live budget or credit ledger.
AUTOREFINE_AZURE_MONTHLY_CREDIT_USD=150

# GitHub access (for cloning repos, creating PRs, committing reports)
GITHUB_TOKEN=
GH_TOKEN=

# NauroLabs ops Telegram bot (created via @BotFather — see PLATFORM.md §8)
NAURO_BOT_TOKEN=
NAURO_CHAT_ID=
